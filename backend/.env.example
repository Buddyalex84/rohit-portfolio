DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=darjee
POSTGRES_USER=darjee
POSTGRES_PASSWORD=darjee
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Set true for local development without PostgreSQL. Production should use PostgreSQL.
USE_SQLITE=false
DATABASE_URL=postgres://darjee:darjee@localhost:5432/darjee

# Public site configuration (leave blank rather than inventing details)
SITE_NAME=Darjee
SITE_PHONE=
SITE_WHATSAPP=
SITE_EMAIL=
SITE_ADDRESS=
SITE_HOURS=Tuesday–Sunday, 11:00–20:00
SITE_MAP_EMBED_URL=
INSTAGRAM_URL=
FACEBOOK_URL=

# Uploads
MAX_UPLOAD_MB=8
MEDIA_ROOT=
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Email (optional; notifications are skipped when unset)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Darjee <noreply@example.com>
STAFF_NOTIFY_EMAIL=
